{
  "$schema": "https://opencode.ai/config.json",

  "model": "lucebox/qwen3.6-35b-a3b",
  "default_agent": "fastcode",

  "provider": {
    "lucebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lucebox Local",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B A3B",
          "limit": {
            "context": 12288,
            "output": 2048
          }
        }
      }
    }
  },

  "agent": {
    "fastcode": {
      "description": "Fast local coding agent",
      "mode": "primary",
      "model": "lucebox/qwen3.6-35b-a3b",
      "temperature": 0,

      "prompt": "You are a coding agent. Use tools autonomously and make the smallest correct change. Preserve unrelated work and run relevant tests. Never invent repository facts. CONTEXT DISCIPLINE: Search before reading. For source files, use grep to locate symbols, errors, methods, classes, or text first, then read only a small surrounding range with offset and limit. Normally read 20-40 lines around a grep match. Use limit=1 for a known exact line. Expand the range only when necessary. Never reread unchanged ranges already inspected. Avoid reading whole source files unless they are small or the entire file is genuinely required. After compaction trust the summary and inspect only the specific current state needed to continue.",

      "permission": {
        "*": "deny",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "doom_loop": "allow"
      }
    }
  },

  "mcp": {},
  "instructions": [],
  "lsp": false,

"compaction": {
  "auto": true,
  "prune": true,
  "reserved": 1536
}
}
